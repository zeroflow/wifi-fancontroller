# Gitignore settings for ESPHome
# This is an example and may include too much for your use-case.
# You can modify this file to suit your needs.
.esphome
secrets.yaml
*_dev.yaml

# Generated by tools/localize-examples.py for test-examples.sh
.test-build/

# Jekyll local development
static/_site/
static/.jekyll-cache/
static/.jekyll-metadata
static/Gemfile.lock
static/.sass-cache/
static/.bundle/
static/vendor/

# Ruby gems
gems/

# Astro site
site/node_modules/
site/dist/
site/.astro/
site/public/firmware/
# Populated in CI by publish-pages.yml from the latest release's datasheet
# assets, never committed to source control
site/public/datasheet/

# 19.1-03: render-manual-pdf.mjs build output - a release-artifact PDF
# attached by publish-manual.yml (plan 04), never committed to source control
site/manual.pdf

# render-datasheet-pdf.mjs build output - release-artifact PDFs attached by
# publish-datasheet.yml, never committed to source control
site/fancontroller-rev*-datasheet-*.pdf

# Claude
CLAUDE.md
.claude/
.planning/
GITHUB-PAT-GUIDE.md
pat_token

# Worktrees
.worktrees/
